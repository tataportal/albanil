# Publish only the static, sanitized preview and documentation.
*
!.gitignore
!README.md
!docs/
!docs/**
!scripts/
!scripts/**
*.php
*.sql
.env*
*credentials*
*secret*
*token*
error_log
.DS_Store

# Local service source only; never private databases, files or passwords.
!service/
!service/*.py
!service/README.md
.local/
__pycache__/
*.sqlite3*
*.private

# Shared exchange-rate service; credentials remain under ignored .local/.
!service/cloud/
!service/cloud/*.mjs
!service/cloud/*.jsonc
!service/cloud/schema.sql
!service/cloud/README.md
service/cloud/.wrangler/
